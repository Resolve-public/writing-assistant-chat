{
  "name": "writing-assistant-chat",
  "version": "1.5.7",
  "description": "Obsidian plugin: Writing Assistant Chat",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "build:css": "postcss src/styles/index.css -o styles.css",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src package.json",
    "lint:fix": "eslint src package.json --fix",
    "lint:css": "stylelint \"src/**/*.css\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:all": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "visual": "node dev/visual/run.mjs",
    "drive": "node dev/driver/run.mjs",
    "update-pricing": "node scripts/update-pricing.mjs",
    "version": "node version-bump.mjs && node scripts/update-pricing.mjs && git add manifest.json versions.json src/api/pricingData.json src/providers/catalogData.json",
    "readme:assets": "node dev/readme/assemble.mjs"
  },
  "keywords": [],
  "author": "Resolve-public",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@electron/asar": "^4.2.0",
    "@eslint/js": "^9.30.0",
    "@eslint/json": "0.14.0",
    "@tailwindcss/postcss": "4.3.2",
    "@types/node": "^20.0.0",
    "@typescript-eslint/utils": "^8.64.0",
    "@vitest/coverage-v8": "^4.1.2",
    "esbuild": "^0.21.0",
    "eslint": "^9.39.0",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "gifenc": "1.0.3",
    "image-q": "4.0.0",
    "obsidian": "1.13.1",
    "playwright": "^1.61.1",
    "pngjs": "7.0.0",
    "postcss": "8.4.49",
    "postcss-cli": "11.0.0",
    "stylelint": "^17.14.0",
    "tailwindcss": "4.3.2",
    "tslib": "2.6.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "markdown-it": "^15.0.0",
    "zod": "4.4.3"
  },
  "overrides": {
    "typescript": "$typescript"
  }
}
